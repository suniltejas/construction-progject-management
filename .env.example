# Local development defaults. Set production values in a private .env file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=
DATABASE_PATH=./data/fieldline.sqlite
# Uploaded files live outside the web root. Keep the max upload size (bytes) in sync with the UI.
FILES_DIR=./data/files
FILES_MAX_BYTES=26214400

# Required for invitations and password resets outside local development.
# Use a sender on a domain verified in Resend for real invitations.
RESEND_API_KEY=
RESEND_FROM=
